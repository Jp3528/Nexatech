{
  "name": "nexatech",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch servidor/inicio.ts",
    "build": "vite build --config configuracion-vite.ts",
    "lint": "oxlint -c configuracion-lint.json codigo servidor pruebas",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test pruebas/*.test.ts pruebas/*.test.tsx",
    "start": "tsx servidor/produccion.ts",
    "db:migrate": "tsx servidor/migrar.ts",
    "db:local": "tsx servidor/configurar-local.ts",
    "catalog:import": "tsx servidor/importar-cli.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "lucide-react": "1.31.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
